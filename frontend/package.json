{
  "name": "ai-quality-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "cd .. && husky frontend/.husky || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.{ts,json}\"",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api-types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.9.1",
    "httpsnippet-lite": "^3.0.5",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.3.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
