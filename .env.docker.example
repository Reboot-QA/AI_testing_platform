# Docker 一键部署环境变量
# 用法: ./linux-deploy.sh init-env  （推荐，会自动写入默认 MySQL 密码到 .env.docker）
# 或: cp .env.docker.example .env.docker && ./linux-deploy.sh up

# 对外端口
HTTP_PORT=5173
BACKEND_PORT=8000

# MySQL（映射端口 MYSQL_PORT，默认 3245；远程直连见 README）
# MYSQL_PUBLISH_HOST=0.0.0.0   允许远程直连（须在云安全组放行 MYSQL_PORT，并使用强密码）
# MYSQL_PUBLISH_HOST=127.0.0.1  仅本机/SSH 隧道
MYSQL_PUBLISH_HOST=0.0.0.0
MYSQL_PORT=3245
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
DB_HOST=mysql
DB_PORT=3306
DB_USER=ai_testcase
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=ai_testcase

# 应用
SECRET_KEY=change-this-to-a-random-secret-key
APP_NAME=AI质量平台

# LLM（OpenAI 兼容 API）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MOCK_MODE=true
AI_GENERATE_BATCH_SIZE=8
AI_GENERATE_CONCURRENCY=4

# 日志
LOG_DIR=/app/logs

# MySQL 备份（默认 /opt，部署/更新时会自动重装 cron；也可手动 backup-setup-cron）
BACKUP_DIR=/opt/ai-platform-backups/mysql
BACKUP_KEEP_DAYS=30
# 每日自动备份时间（24 小时制，默认凌晨 3:00；你之前若是 2:30 可改回下面两行）
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=30

# 独立监控栈（可选，./deploy.sh monitoring start；与平台内置日志监控无关）
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
